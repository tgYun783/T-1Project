{
  "name": "t1-server",
  "version": "0.1.0",
  "private": true,
  "description": "T1 백엔드 (NestJS)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "//test": "mongodb 드라이버 7.7은 os를 동적 import()로 읽는다. jest VM에서 이 플래그가 없으면 핸드셰이크 메타데이터가 빠져 실제 Mongo 연결 테스트가 실패한다.",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.8",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "express-session": "^1.19.0",
    "mongoose": "^9.11.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "js-yaml": "^5.5.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.8",
    "typescript-eslint": "^8.72.1"
  }
}
